# The host where the game server (a Cloudflare Worker) is running. Host only, no https://.
# Local development: localhost:1999 (npm run dev starts it with wrangler dev).
# Staging: vibecoder-staging.<your-subdomain>.workers.dev (after npm run party:staging)
# Production: vibecoder.<your-subdomain>.workers.dev (after npm run party:deploy)
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
