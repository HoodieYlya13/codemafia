{
  "name": "codemafia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,party -c blue,magenta \"npm run dev:next\" \"npm run dev:party\"",
    "dev:next": "next dev",
    "dev:party": "wrangler dev --port 1999",
    "party:deploy": "wrangler deploy",
    "party:staging": "wrangler deploy --env staging",
    "party:types": "wrangler types party/worker-configuration.d.ts",
    "build:dev": "npm run party:staging && next build",
    "build": "npm run party:deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npm run party:types && tsc --noEmit && tsc --noEmit -p party"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "partyserver": "0.5.10",
    "partysocket": "^1.3.0",
    "pyodide": "^0.29.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-react-hooks": "^7.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "wrangler": "4.152.0"
  }
}
