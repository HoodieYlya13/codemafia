{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The game server: one Durable Object per lobby, served at /parties/main/:room.
  "name": "vibecoder",
  "main": "party/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    // Binding "Main" maps to the default "main" party that partysocket connects to.
    "bindings": [{ "name": "Main", "class_name": "CodeMafiaServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CodeMafiaServer"] }],
  "vars": { "ENV_TYPE": "production" },
  "env": {
    // npm run party:staging  →  vibecoder-staging.<subdomain>.workers.dev
    "staging": {
      "name": "vibecoder-staging",
      "vars": { "ENV_TYPE": "staging" },
      "durable_objects": {
        "bindings": [{ "name": "Main", "class_name": "CodeMafiaServer" }]
      }
    }
  }
}
